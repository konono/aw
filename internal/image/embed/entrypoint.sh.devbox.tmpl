#!/bin/bash
set -e

run_as_user() {
  /bin/bash -lc "$1"
}

aw_log() { echo "[aw:entrypoint] $1" >&2; }

# Dynamic /etc/passwd injection for arbitrary UID support (OpenShift GID 0 pattern).
# The image is built with a fixed UID (1001) but runs with the host user's UID via
# --user UID:0. Container runtimes (e.g. Podman --userns=keep-id) may inject a
# passwd entry with the host's home path, which breaks tools that use getpwuid()
# instead of $HOME (ssh, git, nix). Always ensure the entry has the correct home.
_aw_uid=$(id -u)
# Remove ALL passwd entries for this UID (Podman --userns=keep-id may inject
# a duplicate with the host home path, which breaks SSH/git/nix getpwuid).
# Use grep+write instead of sed -i because sed -i creates a temp file in /etc/
# which requires directory write permission that containers may not have.
_aw_tmp=$(grep -v -e "^[^:]*:[^:]*:${_aw_uid}:" -e "^{{.User}}:" /etc/passwd) && printf '%s\n' "$_aw_tmp" > /etc/passwd || true
echo "{{.User}}:x:${_aw_uid}:0:{{.User}}:{{.Home}}:/bin/bash" >> /etc/passwd
unset _aw_uid _aw_tmp
export HOME={{.Home}}

# Fix ownership when runtime UID differs from build-time UID (1001).
# The GID 0 pattern (chmod g=u) grants group read/write, but tools like
# devbox and Nix call chmod() on generated files, which requires file
# ownership — group membership alone is not enough.
if [ "$(stat -c '%u' {{.Home}})" != "$(id -u)" ]; then
  aw_log "Fixing file ownership for UID $(id -u)..."
  sudo chown -R "$(id -u):0" {{.Home}} 2>/dev/null || true
fi
if [ -d /nix/var ] && [ "$(stat -c '%u' /nix/var)" != "$(id -u)" ]; then
  sudo chown -R "$(id -u):0" /nix/var 2>/dev/null || true
fi

# Symlink .claude.json from staging dir to home (for onboarding state persistence)
if [ -n "$AW_CONTAINER_CONFIG_DIR" ] && [ -f "$AW_CONTAINER_CONFIG_DIR/.claude.json" ]; then
  ln -sfn "$AW_CONTAINER_CONFIG_DIR/.claude.json" {{.Home}}/.claude.json
fi

# Create data symlinks for tools that store data separately from config
if [ -n "$AW_DATA_SYMLINKS" ]; then
  IFS=',' read -ra LINKS <<< "$AW_DATA_SYMLINKS"
  for link in "${LINKS[@]}"; do
    LINK_PATH="${link%%:*}"
    TARGET_PATH="${link##*:}"
    mkdir -p "$TARGET_PATH"
    mkdir -p "$(dirname "$LINK_PATH")"
    ln -sfn "$TARGET_PATH" "$LINK_PATH"
  done
fi

WORKSPACE="${HOST_WORKSPACE:-{{.Workspace}}}"
AW_ENV_FILE={{.Home}}/.aw_env.sh
BASHRC_FILE={{.Home}}/.bashrc
BASH_PROFILE_FILE={{.Home}}/.bash_profile

aw_log "Checking workspace packages..."
# AI tool is already installed at build time via Dockerfile.
# Install project packages (supports both devbox.json and mise.toml)
NIX_ENV=""
if [ -f {{.Home}}/.nix-profile/etc/profile.d/nix.sh ]; then
  NIX_ENV="export HOME={{.Home}} && . {{.Home}}/.nix-profile/etc/profile.d/nix.sh 2>/dev/null;"
fi
AW_PKG_FOUND=0
if [ -f "$WORKSPACE/devbox.json" ]; then
  if [ "${AW_SKIP_DEVBOX_INSTALL:-}" = "1" ]; then
    echo "Skipping devbox install (skip_devbox_install is enabled)"
  elif command -v devbox >/dev/null 2>&1 || run_as_user "$NIX_ENV command -v devbox" >/dev/null 2>&1; then
    echo "Installing packages from devbox.json..."
    run_as_user "$NIX_ENV cd \"$WORKSPACE\" && devbox install"
  else
    echo "devbox.json found but devbox is not installed, skipping"
  fi
  AW_PKG_FOUND=1
fi
if [ -f "$WORKSPACE/mise.toml" ] || [ -f "$WORKSPACE/.mise.toml" ]; then
  if [ "${AW_SKIP_MISE_INSTALL:-}" = "1" ]; then
    echo "Skipping mise install (skip_mise_install is enabled)"
  else
    if ! run_as_user 'command -v mise' > /dev/null 2>&1; then
      echo "Installing mise..."
      run_as_user 'curl https://mise.jdx.dev/install.sh | sh'
    fi
    MISE_CMD="export HOME={{.Home}} && export MISE_DATA_DIR={{.Home}}/.local/share/mise && export MISE_CONFIG_DIR={{.Home}}/.config/mise && export MISE_TRUSTED_CONFIG_PATHS=$WORKSPACE && export MISE_YES=1"
    mkdir -p {{.Home}}/.config/mise
    echo "Installing tools from mise.toml..."
    run_as_user "$MISE_CMD && cd \"$WORKSPACE\" && mise install"
  fi
  AW_PKG_FOUND=1
fi
if [ "$AW_PKG_FOUND" = "0" ]; then
  echo "No devbox.json or mise.toml found in workspace."
fi

aw_log "Setting up SSH..."
# Copy and fix permissions on mounted .ssh (read-only mount, so copy first)
if [ -d {{.Home}}/.ssh-host ]; then
  echo "Configuring SSH keys..."
  cp -a {{.Home}}/.ssh-host {{.Home}}/.ssh 2>/dev/null || true
  chmod 700 {{.Home}}/.ssh
  chmod 600 {{.Home}}/.ssh/* 2>/dev/null || true
  chmod 644 {{.Home}}/.ssh/*.pub 2>/dev/null || true
  chmod 644 {{.Home}}/.ssh/known_hosts 2>/dev/null || true
  chmod 644 {{.Home}}/.ssh/config 2>/dev/null || true
fi

# Ensure ~/.ssh exists with permissive host key checking for agent forwarding
if [ -n "$SSH_AUTH_SOCK" ] && [ ! -d {{.Home}}/.ssh ]; then
  mkdir -p {{.Home}}/.ssh
  chmod 700 {{.Home}}/.ssh
  cat > {{.Home}}/.ssh/config <<'SSHCFG'
Host *
  StrictHostKeyChecking accept-new
  UserKnownHostsFile {{.Home}}/.ssh/known_hosts
SSHCFG
  chmod 644 {{.Home}}/.ssh/config
fi

aw_log "Setting up git credentials..."
if [ -n "$GITHUB_TOKEN" ]; then
  cat > {{.Home}}/.git-credential-token <<'CRED'
#!/bin/sh
echo username=x-access-token
echo "password=${GITHUB_TOKEN}"
CRED
  chmod +x {{.Home}}/.git-credential-token
fi

aw_log "Setting up container socket..."
# Fix container socket permissions (no symlink or DOCKER_HOST — tools like
# Claude Code auto-detect /var/run/docker.sock and connect on startup, which
# deadlocks with Podman's systemd socket activation on RHEL).
if [ -S /run/container.sock ]; then
  sudo chmod 666 /run/container.sock 2>/dev/null || true
fi

aw_log "Generating shell environment..."
export HOME={{.Home}}

echo "Initializing shell environment..."

cat > "$AW_ENV_FILE" <<EOF
if [ -n "\${AW_BASH_ENV_LOADED:-}" ] || [ -n "\${AW_BASH_ENV_RECURSION_GUARD:-}" ]; then
  return 0
fi
AW_BASH_ENV_LOADED=1
export HOME={{.Home}}

if [ -f {{.Home}}/.nix-profile/etc/profile.d/nix.sh ]; then
  echo "Loading nix environment..." >&2
  . {{.Home}}/.nix-profile/etc/profile.d/nix.sh 2>/dev/null
fi
case ":\${PATH}:" in
  *:{{.Home}}/.nix-profile/bin:*) ;;
  *) export PATH="{{.Home}}/.nix-profile/bin:\${PATH}" ;;
esac
case ":\${PATH}:" in
  *:{{.Home}}/.local/bin:*) ;;
  *) export PATH="{{.Home}}/.local/bin:\${PATH}" ;;
esac
if [ -f {{.Home}}/.devbox_global_env ]; then
  . {{.Home}}/.devbox_global_env
elif command -v devbox >/dev/null 2>&1; then
  export AW_BASH_ENV_RECURSION_GUARD=1
  eval "\$(devbox global shellenv 2>/dev/null | grep '^export ' || true)"
  unset AW_BASH_ENV_RECURSION_GUARD
fi
if [ -f "${WORKSPACE}/devbox.json" ] && command -v devbox >/dev/null 2>&1; then
  export AW_BASH_ENV_RECURSION_GUARD=1
  eval "\$(cd "${WORKSPACE}" && devbox shellenv 2>/dev/null | grep '^export PATH=' || true)"
  unset AW_BASH_ENV_RECURSION_GUARD
fi
case ":\${PATH}:" in
  *:{{.Home}}/.local/share/mise/shims:*) ;;
  *) export PATH="{{.Home}}/.local/share/mise/shims:\${PATH}" ;;
esac
export MISE_TRUSTED_CONFIG_PATHS="${HOST_WORKSPACE:-{{.Workspace}}}"
export MISE_YES=1
if [ -n "\${GITHUB_TOKEN:-}" ] && [ -x "{{.Home}}/.git-credential-token" ]; then
  export GIT_CONFIG_COUNT=1
  export GIT_CONFIG_KEY_0="credential.https://github.com.helper"
  export GIT_CONFIG_VALUE_0="!{{.Home}}/.git-credential-token"
fi
EOF

cat > "$BASHRC_FILE" <<BASHRC
if [ -f {{.Home}}/.aw_env.sh ]; then
  . {{.Home}}/.aw_env.sh
fi
BASHRC

cat > "$BASH_PROFILE_FILE" <<BASH_PROFILE
if [ -f {{.Home}}/.bashrc ]; then
  . {{.Home}}/.bashrc
fi
BASH_PROFILE

aw_log "Launching: $*"
exec env HOME={{.Home}} BASH_ENV="$AW_ENV_FILE" \
  bash -lc 'exec "$@"' -- "$@"
