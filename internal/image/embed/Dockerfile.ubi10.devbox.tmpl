FROM registry.access.redhat.com/ubi10/ubi:latest

RUN dnf install -y --allowerasing \
      git curl ca-certificates wget openssh-clients sudo xz \
      util-linux-core tar gzip findutils && \
    dnf clean all

RUN (getent passwd 1001 | cut -d: -f1 | xargs -r userdel) 2>/dev/null; \
    useradd -m -s /bin/bash -u 1001 -g 0 {{.User}} && \
    echo 'ALL ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

ENV HOME="{{.Home}}" \
    BASH_ENV="{{.Home}}/.aw_env.sh" \
    PATH="{{.Home}}/.nix-profile/bin:{{.Home}}/.local/bin:${PATH}"

ARG AW_TOOL_PKG=""
ARG AW_GH_VERSION=""
ARG AW_MISE_VERSION=""
ARG AW_EXTRA_PACKAGES=""
COPY . /tmp/aw-build/
RUN if [ -f /tmp/aw-build/ca-cert.pem ]; then \
      cp /tmp/aw-build/ca-cert.pem /etc/pki/ca-trust/source/anchors/custom-ca.crt && \
      update-ca-trust; \
    fi && \
    if [ -n "$AW_EXTRA_PACKAGES" ]; then \
      set -- $AW_EXTRA_PACKAGES && \
      dnf install -y "$@" && \
      dnf clean all; \
    fi && \
    if [ -n "$AW_GH_VERSION" ]; then \
      ARCH=$(uname -m); case $ARCH in aarch64) ARCH=arm64;; x86_64) ARCH=amd64;; *) echo "Unsupported architecture: $ARCH" >&2; exit 1;; esac && \
      curl -fsSL "https://github.com/cli/cli/releases/download/v${AW_GH_VERSION}/gh_${AW_GH_VERSION}_linux_${ARCH}.tar.gz" | tar xz -C /tmp && \
      mv /tmp/gh_${AW_GH_VERSION}_linux_${ARCH}/bin/gh /usr/local/bin/gh && \
      rm -rf /tmp/gh_${AW_GH_VERSION}_linux_${ARCH}; \
    fi && \
    mkdir -p /nix && chown {{.User}}:0 /nix && chmod g=u /nix && \
    mkdir -p {{.Home}}/.config/nix && \
    printf 'sandbox = false\nfilter-syscalls = false\n' > {{.Home}}/.config/nix/nix.conf && \
    chown -R {{.User}}:0 {{.Home}}/.config/nix && \
    su -s /bin/bash {{.User}} -c 'curl -fsSL https://nixos.org/nix/install | sh -s -- --no-daemon' && \
    ln -s {{.Home}}/.local/state/nix/profiles/profile /nix/var/nix/profiles/default && \
    curl -fsSL -o /usr/local/bin/devbox https://releases.jetify.com/devbox && \
    chmod 755 /usr/local/bin/devbox && \
    DEVBOX_SHELLENV='eval "$(devbox global shellenv 2>/dev/null)"' && \
    if [ -n "$AW_TOOL_PKG" ]; then \
      su -s /bin/bash {{.User}} -c "$DEVBOX_SHELLENV; devbox global add $AW_TOOL_PKG"; \
    fi && \
    su -s /bin/bash {{.User}} -c "MISE_VERSION=v\$AW_MISE_VERSION curl -fsSL https://mise.jdx.dev/install.sh | sh" && \
    rm -rf /tmp/aw-build && \
    su -s /bin/bash {{.User}} -c 'export HOME={{.Home}} && . {{.Home}}/.nix-profile/etc/profile.d/nix.sh 2>/dev/null; devbox global shellenv 2>/dev/null | grep "^export " > {{.Home}}/.devbox_global_env || true' && \
    su -s /bin/bash {{.User}} -c '. {{.Home}}/.nix-profile/etc/profile.d/nix.sh 2>/dev/null && nix-collect-garbage -d 2>/dev/null || true' && \
    su -s /bin/bash {{.User}} -c '. {{.Home}}/.nix-profile/etc/profile.d/nix.sh 2>/dev/null && nix-store --optimise 2>/dev/null || true' && \
    chgrp -R 0 {{.Home}} /nix && chmod -R g=u {{.Home}} /nix && chmod g=u /etc/passwd

COPY aw-init.sh /aw-init.sh
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /aw-init.sh /entrypoint.sh && \
    mkdir -p /Users {{.Workspace}} && chown {{.User}}:0 /Users {{.Workspace}} && chmod g=u /Users {{.Workspace}}

USER {{.User}}
WORKDIR {{.Workspace}}

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
