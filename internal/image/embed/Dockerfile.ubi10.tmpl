FROM registry.access.redhat.com/ubi10/ubi:latest

RUN dnf install -y --allowerasing \
      git curl ca-certificates wget openssh-clients sudo xz \
      util-linux-core tar gzip findutils && \
    dnf clean all

ARG HOST_UID=1000
ARG HOST_GID=1000
RUN (getent passwd $HOST_UID | cut -d: -f1 | xargs -r userdel) 2>/dev/null; \
    (getent group $HOST_GID | cut -d: -f1 | xargs -r groupdel) 2>/dev/null; \
    groupadd -g $HOST_GID {{.User}} && \
    useradd -m -s /bin/bash -u $HOST_UID -g $HOST_GID {{.User}} && \
    echo 'ALL ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

RUN mkdir -p /nix && chown {{.User}}:{{.User}} /nix

USER {{.User}}
RUN curl -fsSL https://nixos.org/nix/install | sh -s -- --no-daemon
USER root

RUN ln -s {{.Home}}/.local/state/nix/profiles/profile /nix/var/nix/profiles/default

RUN curl -fsSL -o /usr/local/bin/devbox https://releases.jetify.com/devbox && \
    chmod 755 /usr/local/bin/devbox

ENV HOME="{{.Home}}" \
    BASH_ENV="{{.Home}}/.aw_env.sh" \
    PATH="{{.Home}}/.nix-profile/bin:{{.Home}}/.local/bin:${PATH}"

ARG AW_TOOL_PKG=""
COPY . /tmp/aw-build/
RUN DEVBOX_SHELLENV='eval "$(devbox global shellenv 2>/dev/null)"' && \
    if [ -f /tmp/aw-build/devbox.json ]; then \
      mkdir -p {{.Home}}/.local/share/devbox/global/default && \
      cp /tmp/aw-build/devbox.json {{.Home}}/.local/share/devbox/global/default/devbox.json && \
      chown -R {{.User}}:{{.User}} {{.Home}}/.local/share && \
      su -s /bin/bash {{.User}} -c "$DEVBOX_SHELLENV; devbox global install"; \
    fi && \
    if [ -n "$AW_TOOL_PKG" ]; then \
      su -s /bin/bash {{.User}} -c "$DEVBOX_SHELLENV; devbox global add $AW_TOOL_PKG"; \
    fi && \
    if [ -f /tmp/aw-build/mise.toml ]; then \
      su -s /bin/bash {{.User}} -c 'curl -fsSL https://mise.jdx.dev/install.sh | sh' && \
      mkdir -p {{.Home}}/.config/mise {{.Home}}/.local/share && \
      cp /tmp/aw-build/mise.toml {{.Home}}/.config/mise/config.toml && \
      chown -R {{.User}}:{{.User}} {{.Home}}/.config/mise {{.Home}}/.local/share && \
      su -s /bin/bash {{.User}} -c 'export MISE_YES=1 && {{.Home}}/.local/bin/mise install'; \
    fi && rm -rf /tmp/aw-build

RUN su -s /bin/bash {{.User}} -c 'export HOME={{.Home}} && . {{.Home}}/.nix-profile/etc/profile.d/nix.sh 2>/dev/null; devbox global shellenv 2>/dev/null | grep "^export " > {{.Home}}/.devbox_global_env || true'

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
RUN mkdir -p /Users {{.Workspace}} && chown {{.User}}:{{.User}} /Users {{.Workspace}}

USER {{.User}}
WORKDIR {{.Workspace}}

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
