FROM registry.access.redhat.com/ubi10/ubi:latest

RUN dnf install -y --allowerasing \
      git curl ca-certificates wget openssh-clients sudo xz \
      util-linux-core tar gzip findutils gawk && \
    dnf clean all

RUN (getent passwd 1001 | cut -d: -f1 | xargs -r userdel) 2>/dev/null; \
    useradd -m -s /bin/bash -u 1001 -g 0 {{.User}} && \
    echo 'ALL ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

ENV HOME="{{.Home}}" \
    BASH_ENV="{{.Home}}/.aw_env.sh" \
    PATH="{{.Home}}/.local/bin:${PATH}"

ARG AW_TOOL_INSTALL_SCRIPT=""
ARG AW_GH_INSTALL_SCRIPT=""
ARG AW_EXTRA_PACKAGES=""
COPY . /tmp/aw-build/
RUN if [ -f /tmp/aw-build/ca-cert.pem ]; then \
      cp /tmp/aw-build/ca-cert.pem /etc/pki/ca-trust/source/anchors/custom-ca.crt && \
      update-ca-trust; \
    fi && \
    if [ -n "$AW_EXTRA_PACKAGES" ]; then \
      set -- $AW_EXTRA_PACKAGES && \
      dnf install -y "$@" && \
      dnf clean all; \
    fi && \
    if [ -n "$AW_GH_INSTALL_SCRIPT" ]; then \
      bash -c "$AW_GH_INSTALL_SCRIPT"; \
    fi && \
    if [ -n "$AW_TOOL_INSTALL_SCRIPT" ]; then \
      su -s /bin/bash {{.User}} -c "$AW_TOOL_INSTALL_SCRIPT"; \
    fi && \
    if [ -f /tmp/aw-build/mise.toml ]; then \
      su -s /bin/bash {{.User}} -c 'curl -fsSL https://mise.jdx.dev/install.sh | sh' && \
      mkdir -p {{.Home}}/.config/mise {{.Home}}/.local/share && \
      cp /tmp/aw-build/mise.toml {{.Home}}/.config/mise/config.toml && \
      chown -R {{.User}}:0 {{.Home}}/.config/mise {{.Home}}/.local/share && \
      su -s /bin/bash {{.User}} -c 'export MISE_YES=1 && {{.Home}}/.local/bin/mise install && {{.Home}}/.local/bin/mise ls 2>/dev/null | awk "\$2 ~ /^[0-9]/ {print \$1\"@\"\$2}" | xargs -r {{.Home}}/.local/bin/mise use -g'; \
    fi && rm -rf /tmp/aw-build && \
    chgrp -R 0 {{.Home}} && chmod -R g=u {{.Home}} && chmod g=u /etc/passwd

COPY aw-init.sh /aw-init.sh
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /aw-init.sh /entrypoint.sh && \
    mkdir -p /Users {{.Workspace}} && chown {{.User}}:0 /Users {{.Workspace}} && chmod g=u /Users {{.Workspace}}

USER {{.User}}
WORKDIR {{.Workspace}}

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
