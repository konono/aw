FROM ubuntu:26.04

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      git curl ca-certificates wget openssh-client sudo xz-utils \
      nodejs npm && \
    rm -rf /var/lib/apt/lists/*

RUN (getent passwd 1001 | cut -d: -f1 | xargs -r userdel) 2>/dev/null; \
    useradd -m -s /bin/bash -u 1001 -g 0 {{.User}} && \
    echo 'ALL ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

ENV HOME="{{.Home}}" \
    BASH_ENV="{{.Home}}/.aw_env.sh" \
    PATH="{{.Home}}/.local/bin:${PATH}"

ARG AW_TOOL_PKG=""
ARG AW_TOOL_BINARY_URL=""
ARG AW_TOOL_BINARY_NAME=""
COPY . /tmp/aw-build/
RUN if [ -n "$AW_TOOL_PKG" ]; then \
      npm install -g "$AW_TOOL_PKG"; \
    fi && \
    if [ -n "$AW_TOOL_BINARY_URL" ]; then \
      curl -fsSL -o "/usr/local/bin/${AW_TOOL_BINARY_NAME:-aw-tool}" "$AW_TOOL_BINARY_URL" && \
      chmod 755 "/usr/local/bin/${AW_TOOL_BINARY_NAME:-aw-tool}"; \
    fi && \
    if [ -f /tmp/aw-build/mise.toml ]; then \
      su -s /bin/bash {{.User}} -c 'curl -fsSL https://mise.jdx.dev/install.sh | sh' && \
      mkdir -p {{.Home}}/.config/mise {{.Home}}/.local/share && \
      cp /tmp/aw-build/mise.toml {{.Home}}/.config/mise/config.toml && \
      chown -R {{.User}}:0 {{.Home}}/.config/mise {{.Home}}/.local/share && \
      su -s /bin/bash {{.User}} -c 'export MISE_YES=1 && {{.Home}}/.local/bin/mise install'; \
    fi && rm -rf /tmp/aw-build && \
    chgrp -R 0 {{.Home}} && chmod -R g=u {{.Home}} && chmod g=u /etc/passwd

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && \
    mkdir -p /Users {{.Workspace}} && chown {{.User}}:0 /Users {{.Workspace}} && chmod g=u /Users {{.Workspace}}

USER {{.User}}
WORKDIR {{.Workspace}}

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
